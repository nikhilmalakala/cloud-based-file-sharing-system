# ==============================================================================
# Cloud File Sharing System - .gitignore
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/
package-lock.json.bak

# Secrets & Local Configuration (CRITICAL - NEVER COMMIT SECRETS)
local.settings.json
**/local.settings.json
!local.settings.example.json
!**/local.settings.example.json
.env
.env.*
*.env
.secrets
secrets/
appsettings.json
**/appsettings.json
appsettings.*.json
**/appsettings.*.json

# Azure Functions & Azurite Local Storage Emulator Artifacts
__blobstorage__/
**/__blobstorage__/
__queuestorage__/
**/__queuestorage__/
__tablestorage__/
**/__tablestorage__/
__azurite_db*__.json
**/__azurite_db*__.json
AzuriteConfig
**/AzuriteConfig

# Python / Local Package Artifacts
.python_packages/
.venv/
venv/
env/
__pycache__/
*.py[cod]

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build Outputs & Temporary Files
dist/
build/
bin/
obj/
edge/
Publish/
TestResults/
downloaded-*

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE & Editor Files
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
